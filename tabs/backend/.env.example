# Tab backend (Express) server-side environment variables.
# Names only — never commit real values. These are read from process.env, so
# they have NO REACT_APP_ prefix (that prefix is only for the React client).

# MSAL / Entra token validation
AAD_TENANT_ID=
AAD_CLIENT_ID=

IDENTITY_STATE_SECRET=
PORTAL_URL=

# LNbits admin credentials used only by the backend.
LNBITS_NODE_URL=
LNBITS_USERNAME=
LNBITS_PASSWORD=

# GitHub needs no configuration here: an admin creates the GitHub App from
# the Automations page (manifest flow) and credentials are stored server-side.

# Shared secret the bot sends as Authorization when calling this backend.
# Generate with `openssl rand -hex 32`. Startup fails if unset or left as the
# old 'your-secret-token' placeholder.
TAB_BACKEND_TOKEN=
