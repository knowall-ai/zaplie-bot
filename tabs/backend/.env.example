# Tab backend (Express) server-side environment variables.
# Names only — never commit real values. These are read from process.env, so
# they have NO REACT_APP_ prefix (that prefix is only for the React client).

# MSAL / Entra token validation
AAD_TENANT_ID=
AAD_CLIENT_ID=

IDENTITY_STATE_SECRET=
PORTAL_URL=

# Directory for the backend's mutable JSON stores. REQUIRED in production:
# point it outside the deployment tree so clean deploys cannot wipe live
# state. On Azure App Service use the persistent /home share — /home/data/zaplie
# on Linux, D:\home\data\zaplie on Windows. Every mutable store honours it.
# Leave empty in local development to keep the stores next to the code.
ZAPLIE_DATA_DIR=

# Upper bound in sats for a single zap or self-issued invoice through the
# LNbits gateway. Optional. Left unset it inherits whatever
# REWARDS_MAX_AMOUNT_SATS is set to, and falls back to 1000000 only when
# neither is set — so separating the two caps never loosens an existing
# deployment. Set it to give zaps a ceiling of their own. A malformed value
# fails closed: zaps and invoices are refused with a 503 rather than falling
# back to a wider ceiling.
ZAP_MAX_AMOUNT_SATS=

# LNbits, least privilege (docs/LNBITS_MIGRATION.adoc). Zaplie never logs in
# to LNbits and never uses the admin Users API; it holds only keys of wallets
# owned by the zaplie.service account. No username, password or super-user
# admin key belongs here.
#
# Base URL of the LNbits instance (LNBITS_NODE_URL is still read if unset).
LNBITS_URL=https://your-lnbits-instance.example
# Host Lightning addresses are served on, if it differs from LNBITS_URL's.
# LNBITS_PUBLIC_HOST=
# Optional ACL token of zaplie.service, scoped to POST /api/v1/wallet,
# GET /api/v1/wallets and GET /api/v1/payments. With it a person's Allowance
# wallet is created on their first sign-in; without it an operator links one
# from the admin portal.
LNBITS_API_TOKEN=
# Invoice (read) key of the Treasury wallet, for the automation stats and
# reports. Its admin key belongs to the bot only.
ZAPLIE_TREASURY_INKEY=
# Admin key of the Fund wallet the allowance extension pays from (existing).
ALLOWANCE_FUND_ADMINKEY=
# 64 hex characters (openssl rand -hex 32). Encrypts the wallet keys in
# people.json. Unset, one is generated into secrets.json beside the data,
# which is fine locally; in Azure set it (ideally as a Key Vault reference).
ZAPLIE_STORE_KEY=
# Domains a person's Lightning address may use, comma-separated; `*` allows
# any. Default: the public LNbits host only, so zaps stay on the instance.
# ZAPLIE_LIGHTNING_ADDRESS_DOMAINS=
# The rewards store needs the nostrmarket extension; off unless set to true.
# ZAPLIE_REWARDS_STORE_ENABLED=false

# GitHub needs no configuration here: an admin creates the GitHub App from
# the Automations page (manifest flow) and credentials are stored server-side.

# Shared secret the bot sends as Authorization when calling this backend.
# Generate with `openssl rand -hex 32`. Startup fails if unset or left as the
# old 'your-secret-token' placeholder.
TAB_BACKEND_TOKEN=
