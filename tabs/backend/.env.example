# Tab backend (Express) server-side environment variables.
# Names only — never commit real values. These are read from process.env, so
# they have NO REACT_APP_ prefix (that prefix is only for the React client).

# MSAL / Entra token validation (msalValidator.js)
AAD_TENANT_ID=
AAD_CLIENT_ID=

# LNbits admin credentials for the server-side "Your week" zap history
# (weekRoutes.js). Server-side only — the browser no longer holds these.
LNBITS_NODE_URL=
LNBITS_USERNAME=
LNBITS_PASSWORD=
