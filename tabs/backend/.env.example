# Tab backend (Express) server-side environment variables.
# Names only — never commit real values. These are read from process.env, so
# they have NO REACT_APP_ prefix (that prefix is only for the React client).

# MSAL / Entra token validation
AAD_TENANT_ID=
AAD_CLIENT_ID=

IDENTITY_STATE_SECRET=
PORTAL_URL=

# LNbits admin credentials used only by the backend.
LNBITS_NODE_URL=
LNBITS_USERNAME=
LNBITS_PASSWORD=
LNBITS_ADMINKEY=

# Opening Allowance balance credited when the portal provisions a user who has
# never messaged the bot. Leave empty to provision without funding — the
# account is still created and the skip is logged. A non-empty value must be a
# positive integer; anything else is logged as a configuration error and the
# account is provisioned unfunded.
LNBITS_INITIAL_ALLOWANCE=

# SharePoint host that serves this tenant's profile photos, e.g.
# contoso.sharepoint.com. There is no default: unset, provisioned accounts get
# no avatar instead of a URL pointing at somebody else's tenant.
PROFILE_PHOTO_HOST=

# Mutable JSON stores. Keep the default (backend/) for local development.
# Azure Linux App Service should set this to /home/data/zaplie so deployments
# can replace the application package without replacing runtime state.
ZAPLIE_DATA_DIR=

# GitHub needs no configuration here: an admin creates the GitHub App from
# the Automations page (manifest flow) and credentials are stored server-side.

# Shared secret the bot sends as Authorization when calling this backend.
# Generate with `openssl rand -hex 32`. Startup fails if unset or left as the
# old 'your-secret-token' placeholder.
TAB_BACKEND_TOKEN=
