# Tab backend (Express) server-side environment variables.
# Names only — never commit real values. These are read from process.env, so
# they have no REACT_APP_ prefix (that prefix is only for the React client).

# MSAL / Entra token validation for user-facing identity routes.
AAD_TENANT_ID=
AAD_CLIENT_ID=

# GitHub OAuth app used by the Connect GitHub flow.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
IDENTITY_STATE_SECRET=
PORTAL_URL=

# Shared secret the bot sends to identity resolution and pending-reward routes.
# Generate with `openssl rand -hex 32`. Startup fails if unset or left as the
# old 'your-secret-token' placeholder. Never expose this as REACT_APP_*.
TAB_BACKEND_TOKEN=
