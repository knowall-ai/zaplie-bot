{
  "name": "tabs",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.24.0",
    "@azure/msal-react": "^2.1.0",
    "@fluentui/react": "^8.120.6",
    "@microsoft/teams-js": "^2.34.0",
    "@tanstack/react-query": "5.59.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.3",
    "@yudiel/react-qr-scanner": "^2.0.8",
    "axios": "^1.8.1",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv-flow": "^4.1.0",
    "express": "^4.21.2",
    "http-proxy-middleware": "^2.0.6",
    "jose": "^4.15.9",
    "light-bolt11-decoder": "^3.2.0",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-activity-calendar": "^3.0.1",
    "react-dom": "^18.3.1",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "^7.18.2",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.0.5",
    "webrtc-adapter": "^9.0.1"
  },
  "overrides": {
    "chroma-js": "2.4.2"
  },
  "scripts": {
    "prestart": "npm run tailwind:build",
    "start": "concurrently --kill-others-on-fail \"npm run server:dev\" \"npm run tailwind:watch\" \"react-scripts start\"",
    "server": "node backend/server.js",
    "server:dev": "node --watch backend/server.js",
    "preclient": "npm run tailwind:build",
    "client": "react-scripts start",
    "prebuild": "npm run tailwind:build:production",
    "build": "react-scripts build",
    "tailwind:build": "tailwindcss -i ./src/styles/tailwind.css -o ./public/tailwind.css",
    "tailwind:build:production": "tailwindcss -i ./src/styles/tailwind.css -o ./public/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/styles/tailwind.css -o ./public/tailwind.css --watch",
    "test:backend": "node --test backend/*.test.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src/ --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "typecheck": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "^13.4.0",
    "@types/css-modules": "^1.0.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/react-qr-reader": "^2.1.7",
    "concurrently": "^9.1.2",
    "prettier": "^3.2.0",
    "tailwindcss": "4.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^4.9.5"
  }
}
