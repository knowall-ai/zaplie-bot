{
  "name": "tabs",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.22.0",
    "@azure/msal-react": "^5.7.1",
    "@fluentui/react": "^8.120.6",
    "@microsoft/teams-js": "^2.56.0",
    "@tanstack/react-query": "5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@yudiel/react-qr-scanner": "^2.0.8",
    "axios": "^1.20.0",
    "body-parser": "^1.20.8",
    "cors": "^2.8.5",
    "dotenv-flow": "^4.1.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "http-proxy-middleware": "^4.2.0",
    "jose": "^6.2.12",
    "light-bolt11-decoder": "^3.2.0",
    "moment": "^2.31.0",
    "react": "^19.3.0",
    "react-activity-calendar": "^3.0.1",
    "react-dom": "^19.3.0",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "^7.18.4",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.0.5",
    "webrtc-adapter": "^9.0.1"
  },
  "overrides": {
    "chroma-js": "2.4.2"
  },
  "scripts": {
    "prestart": "npm run tailwind:build",
    "start": "concurrently --kill-others-on-fail \"npm run server:dev\" \"npm run tailwind:watch\" \"react-scripts start\"",
    "server": "node --env-file-if-exists=backend/.env backend/server.js",
    "server:dev": "node --env-file-if-exists=backend/.env --watch backend/server.js",
    "preclient": "npm run tailwind:build",
    "client": "react-scripts start",
    "prebuild": "npm run tailwind:build:production",
    "build": "react-scripts build",
    "tailwind:build": "tailwindcss -i ./src/styles/tailwind.css -o ./public/tailwind.css",
    "tailwind:build:production": "tailwindcss -i ./src/styles/tailwind.css -o ./public/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/styles/tailwind.css -o ./public/tailwind.css --watch",
    "test:backend": "node --test backend/*.test.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "//lint": "ESLINT_USE_FLAT_CONFIG=false keeps this app on its eslintConfig below: ESLint 8 searches ancestor directories and would otherwise pick up the repo-root eslint.config.mjs. Drop it when this app moves to flat config.",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src/ --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint src/ --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "typecheck": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/css-modules": "^1.0.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.7.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-qr-reader": "^2.1.7",
    "concurrently": "^10.0.5",
    "prettier": "^3.2.0",
    "tailwindcss": "4.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^4.9.5"
  }
}
