{
  "name": "Zaplie-sample",
  "version": "1.0.0",
  "description": "Microsoft Teams Toolkit sso bot sample",
  "engines": {
    "node": "24"
  },
  "author": "Microsoft",
  "license": "MIT",
  "main": "./lib/src/index.js",
  "scripts": {
    "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
    "dev": "cross-env NODE_ENV=development nodemon --exec node --inspect=9239 --signal SIGINT -r ts-node/register ./src/index.ts",
    "build-manifest": "node build.js",
    "build": "tsc --build && shx rm -rf lib/public && shx cp -r public lib/public",
    "write-env": "cross-env TEAMSFX_ENV=$TEAMSFX_ENV node scripts/writeEnv.js",
    "start": "node ./lib/src/index.js",
    "watch": "nodemon --exec \"npm run start\"",
    "test": "jest --config jest.config.ts && npm run test:tooling",
    "test:tooling": "node --test scripts/*.test.js",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "coverage:ratchet": "node scripts/check-coverage-ratchet.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/knowall-ai/GetZapl.ie"
  },
  "dependencies": {
    "@azure/ai-projects": "^2.4.0",
    "@azure/identity": "^4.4.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "botbuilder": "^4.23.3",
    "botbuilder-dialogs": "^4.23.3",
    "dotenv": "^17.4.2",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "isomorphic-fetch": "^3.0.0",
    "react-qr-reader": "^3.0.0-beta-1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/teamsfx": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "cross-env": "^7.0.3",
    "env-cmd": "^11.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.2.0",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.4.0",
    "typescript": "^5.6.2"
  }
}
