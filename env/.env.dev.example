# Template for env/.env.dev — copy to env/.env.dev and fill in locally.
# env/.env.dev is gitignored: do NOT commit real values.
# The LNBITS_* values below are read from this file directly (by
# scripts/writeEnv.js) and consumed as-is via process.env — use these plain
# names, not a SECRET_ prefix. The SECRET_/.env.dev.user Teams Toolkit
# convention applies only to AAD_APP_CLIENT_SECRET and BOT_PASSWORD.

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Populated during `teamsapp provision`
BOT_ID=
BOT_DOMAIN=
AAD_APP_CLIENT_ID=
AAD_APP_OBJECT_ID=
AAD_APP_TENANT_ID=
AAD_APP_OAUTH_AUTHORITY=
AAD_APP_OAUTH_AUTHORITY_HOST=
TEAMS_APP_ID=
TEAMS_APP_TENANT_ID=
AAD_APP_ACCESS_AS_USER_PERMISSION_ID=

# LNbits instance
LNBITS_NODE_URL=https://your-lnbits-instance.com
LNBITS_USERNAME=your-username
LNBITS_PASSWORD=your-password
LNBITS_ADMINKEY=your-admin-key
LNBITS_INITIAL_ALLOWANCE=15000
LNBITS_POINTS_LABEL="Sats"

# Host (treasury) wallet that funds the scheduled allowance top-up
LNBITS_HOST_WALLET_ID=
LNBITS_HOST_USER_ID=
LNBITS_INKEY=

# Rewards API
# Shared secret the bot sends to the tab backend; generate with `openssl rand -hex 32`
TAB_BACKEND_TOKEN=
# Base URL of the portal backend API (reward name, identities); the `/api`
# prefix is part of the value, the bot appends routes to it verbatim
WEBSITE_API_URL=http://localhost:5000/api
# Static key accepted by the bot's rewards endpoint
REWARDS_API_KEY=
# Admin key of the LNbits treasury wallet reward payouts are drawn from
REWARDS_TREASURY_ADMINKEY=
# Upper bound in sats for a single reward (default 10000)
REWARDS_MAX_AMOUNT_SATS=10000

# Azure AI Foundry and delegated Microsoft Graph tools
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
GRAPH_CONNECTION_NAME=GraphWorkSignals

# Bot Manifest file variables
CONTENT_URL=https://localhost:3000
WEBSITE_URL=https://localhost:3000
