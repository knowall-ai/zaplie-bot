# Template for env/.env.dev — copy to env/.env.dev and fill in locally.
# env/.env.dev is gitignored: do NOT commit real values.
# The LNBITS_* values below are read from this file directly (by
# scripts/writeEnv.js) and consumed as-is via process.env — use these plain
# names, not a SECRET_ prefix. The SECRET_/.env.dev.user Teams Toolkit
# convention applies only to AAD_APP_CLIENT_SECRET and BOT_PASSWORD.

# Built-in environment variables
TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Populated during `teamsapp provision`
BOT_ID=
BOT_DOMAIN=
AAD_APP_CLIENT_ID=
AAD_APP_OBJECT_ID=
AAD_APP_TENANT_ID=
AAD_APP_OAUTH_AUTHORITY=
AAD_APP_OAUTH_AUTHORITY_HOST=
TEAMS_APP_ID=
TEAMS_APP_TENANT_ID=
AAD_APP_ACCESS_AS_USER_PERMISSION_ID=

# LNbits instance
LNBITS_NODE_URL=https://your-lnbits-instance.com
LNBITS_USERNAME=your-username
LNBITS_PASSWORD=your-password
LNBITS_ADMINKEY=your-admin-key
LNBITS_INITIAL_ALLOWANCE=15000
LNBITS_POINTS_LABEL="Sats"
# Optional in explicit development mode; defaults to the ignored .zaplie-data.
ZAPLIE_DATA_DIR=.zaplie-data

# Rewards API
# Shared secret the bot sends to the tab backend; generate with `openssl rand -hex 32`
TAB_BACKEND_TOKEN=
# Base URL of the portal backend API (reward name, identities); the `/api`
# prefix is part of the value, the bot appends routes to it verbatim
WEBSITE_API_URL=http://localhost:5000/api
# Static key accepted by the bot's rewards endpoint
REWARDS_API_KEY=
# Admin key of the LNbits treasury wallet reward payouts are drawn from
REWARDS_TREASURY_ADMINKEY=
# Upper bound in sats for a single reward (default 10000)
REWARDS_MAX_AMOUNT_SATS=10000
# Upper bound in sats for a single person-to-person zap or self-issued invoice
# through the portal. Left unset it inherits REWARDS_MAX_AMOUNT_SATS above, so
# this template keeps its 10000-sat zap ceiling; set it only to give zaps a
# different ceiling from rewards (with neither set the default is 1000000).
# ZAP_MAX_AMOUNT_SATS=

# Azure AI Foundry and delegated Microsoft Graph tools
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
GRAPH_CONNECTION_NAME=GraphWorkSignals

# Bot Manifest file variables
# Optional release override for the Teams app version (numeric
# major.minor.patch). Leave blank to use manifest.template.json.
APP_VERSION=
# CONTENT_URL / WEBSITE_URL are the tab URLs the Teams manifest points at.
# Set both to the deployed portal URL for a deployed environment.
CONTENT_URL=https://localhost:3000
WEBSITE_URL=https://localhost:3000
# TAB_ENDPOINT / TAB_DOMAIN are written by the local debug tunnel task and are
# only honoured when TEAMSFX_ENV=local. Leave them commented out: a stray
# localhost value here would otherwise be copied into a deployed environment.
# TAB_ENDPOINT=https://localhost:3000
# TAB_DOMAIN=localhost

# Base URL of the Zaplie portal (no trailing slash). Shared name with
# tabs/backend (see tabs/backend/.env.example) — keep the two in sync.
# The bot uses it for card links (e.g. the leaderboard "View Wallets"
# button); if unset, those links are omitted from the cards.
PORTAL_URL=https://localhost:3000

# `show leaderboard`: ranks people by sats zapped out of their Allowance
# wallet in the last N days (whole number, at least 1; same default as the
# portal) and the number of rows shown.
LEADERBOARD_WINDOW_DAYS=7
LEADERBOARD_TOP_N=10
